#Working on Sets

my_set = {1, 2, 3, 4, 5}

#AddingElements

my_set.add(6)

print(my_set)

#Removing Elements

my_set.remove(1) # Raises KeyError if element not found
print(my_set)
my_set.discard(7) # Removes if present, no error if not found
print(my_set)
my_set.pop() # Removes and returns an arbitrary element
print(my_set)
my_set.clear() # Removes all elements
print(my_set)

#Set Operations

set1 = {1, 2, 3}
set2 = {3, 4, 5}

print(set1)
print(set2)

union_set = set1.union(set2) # {1, 2, 3, 4, 5}
print(union_set)
intersection_set = set1.intersection(set2) # {3}
print(intersection_set)
difference_set = set1.difference(set2) # {1, 2} (elements in set1 but not in set2)
print(difference_set)
symmetric_difference_set = set1.symmetric_difference(set2) # {1, 2, 4, 5} (elements in either set but not both)
print(symmetric_difference_set)

#Checking Membership

set_3 = {1, 2, 3, 4, 5}
if 2 in set_3:
    print("2 is in the set")

#Checking Relationships between 2 Sets

set1.issubset(set2) # True if set1 is a subset of set2
print(set1.issubset(set2))
set1.issuperset(set2) # True if set1 is a superset of set2
print(set1.issuperset(set2))
set1.isdisjoint(set2) # True if sets have no common elements
print(set1.isdisjoint(set2))

