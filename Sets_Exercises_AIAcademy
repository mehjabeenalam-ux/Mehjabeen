#Sets

#Creating and Printing values of Empty, Numbers, Strings, Mixed, Duplicate Values, Nested and Constructor Sets

empty_set = {}
numbers = {1, 2, 3, 4, 5}
fruits = {"apple", "banana", "cherry"}
mixed = {1, "hello", 3.14, True}
duplicates = {1, 2, 2, 3, 3, 3}
nested = [{1, 2}, {3, 4}, {5, 6}]
converted = set("hello")

print(empty_set)
print(numbers)
print(fruits)
print(mixed)
print(duplicates)
print(nested)
print(converted)

