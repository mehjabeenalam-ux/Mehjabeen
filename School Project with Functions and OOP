# Method 2 OOP

# Repeating the same task using OOP
class Student:
    def __init__(self, name, score):
        self.name = name
        self.score = score #Instance of Class Created (Blueprint for Object)  
    #Encapsulation using Logic 
    def calculate_grade(self):
        if self.score >= 80:
            return "A"
        elif self.score >= 70:
            return "B"
        elif self.score >=60:
            return "C"
        elif self.score >= 50:
            return "D"
        else:
            return "F"
    def display(self):
        print(f"Student: {self.name}, Score: {self.score}, Grade: {self.calculate_grade()}")

