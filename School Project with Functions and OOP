#School Project to store and calculate names and grades of 10 Students

#Method 1 Function

#Storing the name and grades and calculating grades based on scores for 10 sudents in a school Using Functions

def calculate_grade(score):
    if score >= 80:
        return "A"
    elif score >= 70:
        return "B"
    elif score >=60:
        return "C"
    elif score >= 50:
        return "D"
    else:
        return "F"

def print_statement(name, score):
    grade = calculate_grade(score)
    print(f"Student: {name}, Score: {score}, Grade: {grade}")

print_statement("John", 80)
print_statement("Amy", 90)
