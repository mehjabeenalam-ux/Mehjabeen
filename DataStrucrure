# Creating a list
my_list = ["apple", "banana", "cherry", "apple"]
print(f"Original list: {my_list}")

# Accessing elements by index
print(f"First element: {my_list[0]}")

# Modifying an element
my_list[1] = "orange"
print(f"Modified list: {my_list}")

# Adding an element
my_list.append("grape")
print(f"List after appending: {my_list}")


# Creating a tuple
my_tuple = ("red", "green", "blue", "red")
print(f"Original tuple: {my_tuple}")

# Accessing elements by index
print(f"Second element: {my_tuple[1]}")

# Attempting to modify a tuple (will result in an error)
# my_tuple[0] = "yellow" # This line would raise a TypeError

# Creating a set
my_set = {"cat", "dog", "bird", "cat"}
print(f"Original set (duplicates removed): {my_set}")

# Adding an element
my_set.add("fish")
print(f"Set after adding: {my_set}")

# Removing an element
my_set.remove("dog")
print(f"Set after removing: {my_set}")

# Creating a dictionary
my_dict = {"name": "Alice", "age": 30, "city": "New York"}
print(f"Original dictionary: {my_dict}")

# Accessing values by key
print(f"Name: {my_dict['name']}")

# Modifying a value
my_dict["age"] = 31
print(f"Modified dictionary: {my_dict}")

# Adding a new key-value pair
my_dict["occupation"] = "Engineer"
print(f"Dictionary after adding: {my_dict}")

# Removing a key-value pair
del my_dict["city"]
print(f"Dictionary after removing: {my_dict}")
