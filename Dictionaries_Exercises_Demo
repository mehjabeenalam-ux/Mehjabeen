  "Germany": "Berlin", 
  "Canada": "Ottawa", 
  "England": "London"
}

if "Germany" in country_capitals_with_function:
  print("Yes, 'Germany' is one of the keys in this dictionary")

if "Netherlands" in country_capitals_with_function:
  print("Yes, 'Germany' is one of the keys in this dictionary")
else:
    print("Key is not present in this Dictionary")

#User Input

country_key = str(input("Enter the key name: "))

if country_key in country_capitals_with_function:
  print("Yes, this Key exists in this dictionary")
