#Factorial using While Loops
n = int(input("Enter a positive integer: "))
factorial = 1
counter = 1
while counter <= n:
    factorial *= counter
    counter += 1
print(f"Factorial of {n} using While Loop! = {factorial}")
    
# #Factorial Using Recursive Function
def factorial_1(m):
    if (m==1 or m==0):
        return 1
    else:
        # n! = n x (n - 1)!
        return m * factorial_1(m - 1)

m = int(input("Enter a positive integer: "))
print(f"Factorial of 5 using Recursive Function {m}! = {factorial_1}")

