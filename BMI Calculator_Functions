#Patients' BMI auto calculations

def patient_details(name, age, weight1, height1):
    bmi_calculator = weight1/(height1**2)*10000
    bmi_score = bmi_calculator
    print(f"{name} is {age} years old, height is {height1} cm, weight is {weight1} kg with a BMI assessment of {bmi_score:.2f}")

    if bmi_score <= 18.5:
        print("Patient is Underweight")
    elif bmi_score >= 18.5 and bmi_score <= 24.9:
        print("Patient is Overweight")
    elif bmi_score >= 25 and bmi_score <= 29.9:
        print("Patient is Obese")
    elif bmi_score >= 30:
        print("Patient is Class 1 Obese")
    elif bmi_score >= 30 and bmi_score <= 34.9:
        print("Patient is Class 2 Obese")
    elif bmi_score >= 35 and bmi_score <= 39.9:
        print("Patient is Class 3 Obese")
    else:
        print("Patient is Severely Obese")

patient_details(name = "John", age = 30, weight1 = 100, height1 = 160)
patient_details(name = "Sarah", age = 21, weight1 = 80, height1 = 180)
patient_details(name = "Adam", age = 40, weight1 = 120, height1 = 170)
patient_details(name = "Amy", age = 25, weight1 = 75, height1 = 175)
