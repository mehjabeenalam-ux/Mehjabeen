# Loops in Python usually refers to WHile Loop and For Loop. 
# While Loop will execute a block of codes while the condition is True

# Basic While Loop

value = 1
while value < 10:
    print(value)
    value += 1

value = 1
while value <= 10:
    print(value)
    value += 1

value = 1
while value <= 10:
    if value == 5:
        break 
    print(value)
    value += 1

value = 1
while value <= 10:
    value += 1
    if value == 5: 
        continue 
    print(value)
else: 
    print("Value is now equal to + str(value)")

