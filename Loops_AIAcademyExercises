#For Loop

#Printing even numbers between 1 and 10 using For Loop

for num in range(2,11,2):
    print(num)

# #Printing numbers in reverse order between 1 and 10 using For Loop

for num in range(10,0,-1):
    print(num)

# #Printing all numbers between 1 and 10 using For Loop

for num in range(1,11,1):
    print(num)

#Printing names from a list using For Loop

names = ["Dave", "Sara", "John"]
for x in names:
    print(x)

for x in "Mississippi":
    print(x)

for x in names:
    if x == "Sara":
        break
    print(x)

for x in names:
    if x == "Sara":
        continue
    print(x)

for x in range(4): #Starts at 0 
    print(x)

for x in range(2, 4): #Starts at 2 and ends at 4 thats why 4 is not printed
    print(x)

#Printing between 0 and 100

for x in range(0, 100, 5): 
    print(x)

# #Printing between 5 and 100

for x in range(5, 101, 5): 
    print(x)

# #printing with differences of 5 between 1 and 100

for x in range(95, 0, -5): 
    print(x)
else:
    print("Glad that\'s over!")

