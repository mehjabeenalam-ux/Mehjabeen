def check_password(password):
    password = str(input("Enter your password: "))
    print(password)
    # 1. Check length
    def has_length(p):
        return len(p) >= 8
    # 2. Check uppercase letter
    def has_upper(p):
        return any(c.isupper() for c in p)
    # 3. Check lowercase letter
    def has_lower(p):
        return any(c.islower() for c in p)
    # 4. Check number
    def has_number(p):
        return any(c.isdigit() for c in p)
    # 5. Check special symbol
    def has_special(p):
        symbols = "!@#$%^&*()-_=+[]{};:,.<>/?"
        return any(c in symbols for c in p)
    # Combine all checkers
    if (has_length(password) and
        has_upper(password) and
        has_lower(password) and
        has_number(password) and
        has_special(password)):
        return "✅ Password is SAFE for the bank!"
    else:
        return "❌ Password is NOT safe enough!"
    
print(check_password(""))

